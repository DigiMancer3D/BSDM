# Application manifest for LOFZ (Lights Out Flipper Zero)
[Application]
Name = LOFZ
Description = Lights Out for Flipper Zero
AppVersionMajor = 1
AppVersionMinor = 0
AppVersionPatch = 0
Author = DigiMancer3D
Icon = Icon_Light # (optional, must match a .c icon in your source, or remove this line for default)
StackSize = 1024

[Build]
EntryPoint = main # (usually your main function, adjust if different)